{
  "name": "@studio-engine/render",
  "version": "0.1.0",
  "private": true,
  "description": "RenderEngine for Node: Remotion (chunked, cached) or FFmpeg (draft), JS audio mixer, loudness mastering, QC. Used by the local montage.py pipeline through its CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/bundler": "4.0.528",
    "@remotion/renderer": "4.0.528",
    "@studio-engine/scene-engine": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "bin": {
    "studio-render": "./bin/studio-render.mjs"
  }
}
